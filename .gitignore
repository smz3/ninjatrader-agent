# state.db is a local cache - the shared tasks/handovers are tracked as
# JSON files under .claude/state/ instead (see .claude/scripts/lib/state_files.py)
.claude/state.db
.claude/state.db-journal
.claude/state.db-wal
.claude/state.db-shm
.claude/state/**/*.tmp
.claude/db-history/
__pycache__/

# secrets - never track these (see .claude/scripts/git_safe.py SECRET_GLOBS)
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
*credentials*.json
*.p12
*.pfx
