# state.db IS tracked (user's call, 2026-09-10) - only its SQLite side files are ignored
.claude/state.db-journal
.claude/state.db-wal
.claude/state.db-shm
.claude/db-history/
__pycache__/

# secrets - never track these (see .claude/scripts/git_safe.py SECRET_GLOBS)
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
*credentials*.json
*.p12
*.pfx
