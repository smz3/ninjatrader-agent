{
  "id": "gap-fill",
  "name": "Small gap fill",
  "kind": "setup",
  "family": "mean-reversion",
  "status": "tested",
  "version": 1,
  "source": "task #2 test plan 2026-09-11",
  "thesis": "Small opening gaps vs the prior RTH close often fill the same morning.",
  "rules": "gap = 09:30 open - prior RTH close (same contract). If min_gap <= |gap| <= max_gap (x ATR14), trade toward the prior close at the open of the bar entry_delay_min after 09:30 (skip if already filled). Stop = spec.stop x ATR14 from fill, target = prior close. Max 1/day, flat 12:00. Code: tools/backtest/setups/gap_fill.py.",
  "data_needed": [
    "ohlcv-1m",
    "news"
  ],
  "spec": {
    "instrument": "ES",
    "bar": "1m",
    "sides": "both",
    "entry_window": [
      "09:30",
      "09:45"
    ],
    "flat_by": "12:00",
    "entry_order": "market",
    "stop": {
      "type": "atr",
      "value": 0.15
    },
    "target": {
      "type": "structure",
      "value": null,
      "note": "prior RTH close (gap filled)"
    },
    "max_stop_pts": 20,
    "max_trades_per_day": 1,
    "news_buffer_min": [
      5,
      5
    ]
  },
  "params": {
    "gap_unit": "atr",
    "min_gap": 0.05,
    "max_gap": 0.25,
    "entry_delay_min": 0
  },
  "grid": {
